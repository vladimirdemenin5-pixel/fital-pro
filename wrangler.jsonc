{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "red-waterfall-2af8",
  "main": "_worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fital-pro-db",
"database_id": "d2bdb339-bc7b-420e-be7f-0496ce46a09b",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "YOOKASSA_SHOP_ID",
      "YOOKASSA_SECRET_KEY"
    ]
  },
  "observability": {
    "enabled": true
  }
}
