{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "red-waterfall-2af8",
  "main": "_worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fital-pro-db",
      "database_id": "d2bdb339-bc7b-420e-be7f-0496ce46a09b",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "fital-pro-preview-db",
        "database_id": "54bd4cbb-f267-4c1e-af16-cdc9b24953c1",
        "migrations_dir": "migrations"
      }
    ],
    "ai": {
      "binding": "AI"
    },
    "vars": {
      "ROBOKASSA_IS_TEST": "1",
      "ROBOKASSA_LIVE_ENABLED": "0"
    }
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "ROBOKASSA_LIVE_ENABLED": "0"
  }
}
